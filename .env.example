# Copy to .env and fill in real values. Never commit .env.
HTTP_PORT=8080

POSTGRES_USER=taskmanager
POSTGRES_PASSWORD=taskmanager
POSTGRES_DB=taskmanager
POSTGRES_PORT=5434
DATABASE_URL=postgres://taskmanager:taskmanager@localhost:5434/taskmanager?sslmode=disable

# JWT secret for signing tokens. The server refuses to start without it.
# Change it to a long random value; never commit a real one.
JWT_SECRET=change-me-to-a-long-random-secret
JWT_TTL_HOURS=24

# Optional: host shown in the Swagger UI. Leave empty to use the host
# baked into docs/ by `swag init` (localhost:8080).
# SWAGGER_HOST=api.example.com:8080

# Environment: dev or production. Only in dev does a 500 return the
# exact error to the client; in production the client gets a generic
# message and the detail stays in the log. Default is production.
APP_ENV=dev

# Log level: debug, info, warn, error. Default is info.
LOG_LEVEL=info
